# ============================================================
# Luweero Community SS Portal — Backend Environment Variables
# Copy this file to .env for local development.
# On Vercel, set these under Project Settings -> Environment Variables.
# ============================================================

# Neon PostgreSQL connection string.
# In the Neon dashboard: Project -> Connection Details -> "Pooled connection"
# (important: use the POOLED string, not the direct one — Vercel serverless
# functions open/close connections per-request and the direct connection
# limit on the free tier is very low).
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/lcs_portal?sslmode=require

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# How long an issued token stays valid (jsonwebtoken "expiresIn" format).
JWT_EXPIRES_IN=12h

# Comma-separated list of origins allowed to call this API.
# If your frontend is hosted at e.g. https://lcs-portal.vercel.app or opened
# via GitHub Pages / Netlify, list that origin here. Use "*" only while
# testing locally.
CORS_ORIGIN=*

# Port for local `npm start` / `npm run dev`. Vercel ignores this — it
# manages the port itself for serverless functions.
PORT=5000

# ------------------------------------------------------------
# Resource panel file storage (Vercel Blob).
# In the Vercel dashboard: Storage -> Create Database -> Blob, then
# connect it to this project — Vercel injects this token automatically
# in production. For local dev, run `vercel env pull` or copy the token
# from the dashboard. Without it, uploads still work but fall back to
# storing files as base64 inside Postgres — fine for a few small files,
# but not recommended long-term.
# ------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
